[sub_resource type="GDScript" id="GDScript_jq8tk"]
script/source = "extends Node3D
@onready var area: Area3D = $Area3D
@onready var box: Node3D = $\"../../box\"
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	print(\"box is PhysicsBody3D: \", box is PhysicsBody3D)
	print(\"box: \", box)
	pass
	
	
func _physics_process(_delta: float) -> void:
	var other_body =  $\"../../box\" # узел, с которым проверяем
	if area.overlaps_body(other_body):
		print(\"Area3D пересекается с \", other_body.name)
"

