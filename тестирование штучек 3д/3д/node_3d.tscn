[sub_resource type="GDScript" id="GDScript_a202f"]
script/source = "extends Node3D

@export var move_speed := 3.0
@export var waypoints: Array[Node3D] = []
@export var player: Node3D

@onready var nav_agent: NavigationAgent3D = $NavigationAgent3D

var is_active := false
var is_escaping := false  # Флаг: box убегает к точке
var escape_target: Vector3 = Vector3.ZERO
var rotation_speed := 2.0

func _ready() -> void:
	var players = get_tree().get_nodes_in_group(\"player\")
	if players.size() > 0:
		player = players[0]
	
	nav_agent.path_desired_distance = 0.5
	nav_agent.target_desired_distance = 0.5

func on_looked_at() -> void:
	if not is_active:
		is_active = true
		is_escaping = true  # Начинаем убегать
		escape_target = _find_nearest_waypoint()
		print(\"👁️ На box смотрят — убегает к точке: \", escape_target)

func on_looked_away() -> void:
	if is_active:
		is_active = false
		print(\"🙈 Взгляд убран, но box продолжит бежать к точке\")
		# НЕ сбрасываем is_escaping — box должен добежать

func _find_nearest_waypoint() -> Vector3:
	if waypoints.size() == 0:
		return global_position
	
	var nearest := waypoints[0]
	var min_dist := global_position.distance_to(nearest.global_position)
	
	for wp in waypoints:
		var dist := global_position.distance_to(wp.global_position)
		if dist < min_dist:
			min_dist = dist
			nearest = wp
	
	return nearest.global_position

func _physics_process(delta: float) -> void:
	var target_position: Vector3
	
	if is_escaping:
		# Убегаем к точке (даже если взгляд уже отведён)
		target_position = escape_target
		
		# Проверяем, достигли ли точки
		if global_position.distance_to(target_position) < 1.0:
			print(\"✅ Box достиг точки укрытия\")
			is_escaping = false  # Теперь можно идти к игроку
	else:
		# Идём к игроку
		if player == null:
			return
		target_position = player.global_position
	
	nav_agent.target_position = target_position
	
	if nav_agent.is_navigation_finished():
		return
	
	var next_path_position = nav_agent.get_next_path_position()
	var direction = (next_path_position - global_position).normalized()
	var movement = direction * move_speed * delta
	global_position += movement
	
	if direction.length() > 0.01:
		var target_rotation = atan2(direction.x, direction.z)
		rotation.y = lerp_angle(rotation.y, target_rotation, 10.0 * delta)
"

